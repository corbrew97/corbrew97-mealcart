# Required: used to generate meal plans with Claude
ANTHROPIC_API_KEY=

# Optional: enables the "Order with Instacart" button.
# Get a key at https://www.instacart.com/company/business/developers
INSTACART_API_KEY=
# "development" (sandbox) or "production"
INSTACART_ENV=development

# Optional: link shown on the Instacart page back to this app
MEALCART_PUBLIC_URL=

# Optional: set to 1 to skip Claude and always return a sample plan (for trying the UI)
MEALCART_DEMO=
